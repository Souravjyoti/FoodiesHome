<%- include('../partials/header') %>

<div class="container" style="margin-top: 25px">
    <h1 style="text-align: center">Enter New Password</h1>

    <form action="/reset/<%= token %>" method="POST" style="width: 45%; margin: 20px auto">
        <div class="form-group">
            <input type="password" name="password" placeholder="New Password" class="form-control" required>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Update Password</button>
    </form>
</div>

<%- include('../partials/footer') %>